      "hasOccupation": ["componist", "docent"],
      "description": "Zijn derde symfonie, „Aan mijn vaderland”, is een mijlpaal van de Nederlandse nationale romantiek." },
    { "@id": "som:person/rontgen", "name": "Julius Röntgen", "sortName": "Röntgen, Julius", "gender": "male",
      "birthDate": 1855, "birthPlace": "som:place/leipzig", "deathDate": 1932, "deathPlace": "som:place/bilthoven",
      "hasOccupation": ["pianist", "componist", "docent"],
      "description": "Geboren in Leipzig, vestigde zich in Amsterdam en was medeoprichter van het conservatorium daar." },
    { "@id": "som:person/valerius", "name": "Adrianus Valerius", "sortName": "Valerius, Adrianus", "gender": "male",
      "birthPlace": "som:place/middelburg", "deathDate": 1625, "deathPlace": "som:place/veere",
      "hasOccupation": ["dichter", "liedverzamelaar"],
      "description": "Zeeuws dichter. Zijn Nederlandtsche Gedenck-clanck (1626) bewaart de melodie van het Wilhelmus zoals we die nu zingen." },
    { "@id": "som:person/pijper", "name": "Willem Pijper", "sortName": "Pijper, Willem", "gender": "male",
      "birthDate": 1894, "birthPlace": "som:place/zeist", "deathDate": 1947, "deathPlace": "som:place/leidschendam",
      "hasOccupation": ["componist", "criticus"],
      "description": "Studeerde compositie bij Johan Wagenaar. In 1906 is hij nog een schooljongen: de winkel heeft nog geen muziek van hem, maar de personendata kent hem al." },
    { "@id": "som:person/mengelberg", "name": "Willem Mengelberg", "sortName": "Mengelberg, Willem", "gender": "male",
      "birthDate": 1871, "birthPlace": "som:place/utrecht", "deathDate": 1951,
