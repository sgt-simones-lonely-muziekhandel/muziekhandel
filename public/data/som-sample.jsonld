      "hasOccupation": ["componist", "classicus"],
      "description": "Grotendeels autodidact in de muziek; gaf Latijn en Grieks voordat hij zich aan het componeren wijdde." },
    { "@id": "som:person/zweers", "name": "Bernard Zweers", "sortName": "Zweers, Bernard", "gender": "male",
